      "text": "int8_t / uint8_t        1        exact 8-bit\n\nint16_t / uint16_t        2        exact 16-bit\n\nint32_t / uint32_t        4        exact 32-bit\n\nint64_t / uint64_t        8        exact 64-bit",
      "fontSize": 20,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "int8_t / uint8_t        1        exact 8-bit\n\nint16_t / uint16_t        2        exact 16-bit\n\nint32_t / uint32_t        4        exact 32-bit\n\nint64_t / uint64_t        8        exact 64-bit",
      "autoResize": false,
      "lineHeight": 1.35
